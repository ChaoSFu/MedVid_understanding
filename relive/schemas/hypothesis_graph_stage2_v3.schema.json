{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relive-claimgen-stage2-v3",
  "type": "object",
  "properties": {
    "plan_status": {
      "enum": [
        "PLANNED",
        "INCOMPLETE_PLAN",
        "UNABLE_TO_PLAN",
        "UNRESOLVED_TARGET_REFERENCE"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^H[1-6]$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "enum": [
              "OBJECT",
              "ATTRIBUTE",
              "STATIC_RELATION",
              "TEMPORAL_EVENT",
              "HIGH_LEVEL"
            ]
          },
          "role": {
            "enum": [
              "TARGET",
              "PREREQUISITE",
              "DISAMBIGUATOR",
              "INTERPRETATION"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 6
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 6
          },
          "alternative_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 6
          }
        },
        "required": [
          "claim_id",
          "text",
          "type",
          "role",
          "requirement_ids",
          "requires",
          "alternative_to"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
    },
    "unresolved_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "requirement_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "requirement_id",
          "issue"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "uncovered_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 6
    }
  },
  "required": [
    "plan_status",
    "claims",
    "unresolved_references",
    "requirement_issues",
    "uncovered_requirements"
  ],
  "additionalProperties": false
}

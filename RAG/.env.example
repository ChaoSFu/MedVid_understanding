# Export these variables in your shell; never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=3
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=20
LLM_RESPONSE_FORMAT=auto
# Optional provider extension: empty omits the parameter; true/false sends it.
# For the tested Qwen4-Max non-thinking extraction request, use false.
LLM_ENABLE_THINKING=
# Per-request output ceiling, included in cache/build identity and cost reserve.
LLM_MAX_OUTPUT_TOKENS=6000
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
ENABLE_VISION_EXTRACTION=false
